# Copy to backend/.env.test and fill in values for local/CI test runs.
DATABASE_URL=postgresql://user:password@localhost:5432/sahaya_test
DB_MODE=prisma
NODE_ENV=test

SUPABASE_URL=http://localhost:54321
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

PUBLIC_COMPLAINTS_ENABLED=true
PUBLIC_OTP_ALLOW_SMS_SKIP=true
PUBLIC_OTP_HMAC_SECRET=test-otp-hmac-secret-for-ci-only
TENANT_CLIENTS_ENABLED=true
SMS_TEST_MODE=true
SMS_ENABLED=false
PROCESS_ROLE=api
