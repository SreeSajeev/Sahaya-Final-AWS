// Prisma schema for direct PostgreSQL (RDS-ready).
// After connecting DATABASE_URL to your Postgres, run:
//   npx prisma db pull
// to align this model 1:1 with your live database, then:
//   npx prisma generate
//
// The Ticket model below matches `public.tickets` from full_dump.sql in this repo.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Maps to public.tickets — column set from full_dump.sql (sahaya/full_dump.sql)
model Ticket {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticketNumber          String    @unique @map("ticket_number")
  status                String    @default("OPEN")
  complaintId           String?   @map("complaint_id")
  vehicleNumber         String?   @map("vehicle_number")
  /// FK to client_vehicles (nullable for legacy / free-text / email tickets).
  vehicleId             String?   @map("vehicle_id") @db.Uuid
  /// Snapshots captured at ticket create/update so renames do not rewrite history.
  vehicleName           String?   @map("vehicle_name")
  vehicleType           String?   @map("vehicle_type")
  registrationNumber    String?   @map("registration_number")
  category              String?
  issueType             String?   @map("issue_type")
  location              String?
  state                 String?
  openedByEmail         String?   @map("opened_by_email")
  openedAt              DateTime? @default(now()) @map("opened_at") @db.Timestamp(6)
  currentAssignmentId   String?   @map("current_assignment_id") @db.Uuid
  createdAt             DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt             DateTime? @default(now()) @map("updated_at") @db.Timestamp(6)
  rawEmailId            String?   @map("raw_email_id") @db.Uuid
  remarks               String?
  source                String?   @default("EMAIL")
  confidenceScore       Int?      @map("confidence_score")
  needsReview           Boolean?  @map("needs_review")
  ackEmailSent          Boolean?  @default(false) @map("ack_email_sent")
  resolvedAt            DateTime? @map("resolved_at") @db.Timestamp(6)
  priority              Boolean?  @default(false)
  priorityLevel         String    @default("MEDIUM") @map("priority_level")
  clientSlug            String?   @map("client_slug")
  verificationRemarks   String?   @map("verification_remarks")
  organisationId        String?   @map("organisation_id") @db.Uuid
  shortDescription      String?   @map("short_description")
  reviewNotes           String?   @map("review_notes")
  resolutionCategory    String?   @map("resolution_category")
  /// FK to tenant_resolution_locations (nullable for historical tickets).
  resolutionLocationId  String?   @map("resolution_location_id") @db.Uuid
  /// Snapshot of attended location name at Verify & Close (immutable).
  resolutionLocationName String?  @map("resolution_location_name")
  /// Immutable snapshot of configurable Verify & Close field defs + values.
  closeFormSnapshot     Json?     @map("close_form_snapshot")
  /// Manager rejection reason (queryable for reports). Historical rows may be null.
  rejectionReason       String?   @map("rejection_reason")
  rejectedAt            DateTime? @map("rejected_at") @db.Timestamptz(6)
  rejectedBy            String?   @map("rejected_by") @db.Uuid
  /// Tenant SLA snapshots at ticket creation (immutable for historical tickets).
  responseSlaMinutes    Int?      @map("response_sla_minutes")
  resolutionSlaMinutes  Int?      @map("resolution_sla_minutes")
  responseDueAt         DateTime? @map("response_due_at") @db.Timestamptz(6)
  resolutionDueAt       DateTime? @map("resolution_due_at") @db.Timestamptz(6)
  /// Lazily refreshed escalation level (1–5); null when SLA not configured / not escalated.
  escalationLevel       Int?      @map("escalation_level")
  assignments           TicketAssignment[]
  clientVehicle         ClientVehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  resolutionLocation    TenantResolutionLocation? @relation(fields: [resolutionLocationId], references: [id], onDelete: SetNull)

  @@index([vehicleId], map: "tickets_vehicle_id_idx")
  @@index([responseDueAt], map: "tickets_response_due_at_idx")
  @@index([resolutionDueAt], map: "tickets_resolution_due_at_idx")
  @@index([resolutionLocationId], map: "tickets_resolution_location_id_idx")
  @@map("tickets")
}

model Organisation {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                  String
  slug                  String    @unique
  /// Operator-friendly short label (not the slug). Nullable for historical rows.
  shortName             String?   @map("short_name")
  createdAt             DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  status                String    @default("active")
  // NOTE: no `email` column on live TEST organisations (use incoming_emails / spoc_email).
  spocName              String?   @map("spoc_name")
  spocEmail             String?   @map("spoc_email")
  spocPhone             String?   @map("spoc_phone")
  incomingEmails        Json?     @map("incoming_emails")
  outgoingEmails        Json?     @map("outgoing_emails")
  reviewFieldLabel      String?   @map("review_field_label")
  reviewFieldHelperText String?   @map("review_field_helper_text")
  tenantSla             TenantSla?

  @@map("organisations")
}

/// One SLA configuration per tenant (response + resolution + escalations + business hours config).
model TenantSla {
  id                   String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId       String       @unique @map("organisation_id") @db.Uuid
  responseMinutes      Int          @map("response_minutes")
  resolutionMinutes    Int          @map("resolution_minutes")
  /// [{ "level": 1, "percent": 50 }, ...] — 1 to 5 levels
  escalationLevels     Json         @map("escalation_levels")
  businessHoursEnabled Boolean      @default(false) @map("business_hours_enabled")
  startTime            String?      @map("start_time")
  endTime              String?      @map("end_time")
  /// Weekday numbers 0–6 (Sun–Sat) or 1–7; stored as JSON array
  workingDays          Json?        @map("working_days")
  createdAt            DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime     @default(now()) @map("updated_at") @db.Timestamptz(6)
  organisation         Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@map("tenant_slas")
}

model User {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  authId            String?   @map("auth_id") @db.Uuid
  name              String
  email             String    @unique
  role              String
  active            Boolean?  @default(true)
  isActive          Boolean?  @default(true) @map("is_active")
  approvalStatus    String?   @default("pending") @map("approval_status")
  organisationId    String?   @map("organisation_id") @db.Uuid
  clientSlug        String?   @map("client_slug")
  createdAt         DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  passwordHash      String?   @map("password_hash")
  passwordChangedAt DateTime? @map("password_changed_at") @db.Timestamptz(6)
  lastLoginAt       DateTime? @map("last_login_at") @db.Timestamptz(6)
  authSessions      AuthSession[]
  passwordResetTokens PasswordResetToken[]

  @@map("users")
}

model AuthSession {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash")
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  replacedById     String?   @map("replaced_by_id") @db.Uuid
  userAgent        String?   @map("user_agent")
  ipHash           String?   @map("ip_hash")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastUsedAt       DateTime? @map("last_used_at") @db.Timestamptz(6)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model PasswordResetToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model RawEmail {
  id                  String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  messageId           String        @map("message_id")
  threadId            String?       @map("thread_id")
  fromEmail           String        @map("from_email")
  toEmail             String        @map("to_email")
  subject             String?
  receivedAt          DateTime      @map("received_at") @db.Timestamp(6)
  payload             Json
  ticketCreated       Boolean?      @default(false) @map("ticket_created")
  createdAt           DateTime?     @default(now()) @map("created_at") @db.Timestamp(6)
  processingStatus    String?       @map("processing_status")
  processingClaimedAt DateTime?     @map("processing_claimed_at") @db.Timestamptz(6)
  organisationId      String?       @map("organisation_id") @db.Uuid
  rawText             String?       @map("raw_text")
  rawHtml             String?       @map("raw_html")
  processingError     String?       @map("processing_error")
  linkedTicketId      String?       @map("linked_ticket_id") @db.Uuid
  missingFields       Json?         @map("missing_fields")
  parsedEmails        ParsedEmail[]

  @@map("raw_emails")
}

model ParsedEmail {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  rawEmailId      String    @map("raw_email_id") @db.Uuid
  complaintId     String?   @map("complaint_id")
  vehicleNumber   String?   @map("vehicle_number")
  category        String?
  issueType       String?   @map("issue_type")
  location        String?
  reportedAt      DateTime? @map("reported_at") @db.Timestamp(6)
  remarks         String?
  confidenceScore Decimal?  @map("confidence_score") @db.Decimal
  needsReview     Boolean?  @default(false) @map("needs_review")
  createdAt       DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  ticketCreated   Boolean?  @default(false) @map("ticket_created")
  organisationId  String?   @map("organisation_id") @db.Uuid
  rawEmail        RawEmail  @relation(fields: [rawEmailId], references: [id], onDelete: Cascade)

  @@map("parsed_emails")
}

model TicketComment {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticketId       String    @map("ticket_id") @db.Uuid
  source         String
  authorId       String?   @map("author_id") @db.Uuid
  body           String?
  attachments    Json?
  createdAt      DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  organisationId String?   @map("organisation_id") @db.Uuid

  @@map("ticket_comments")
}

model AuditLog {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entityType     String   @map("entity_type")
  entityId       String   @map("entity_id") @db.Uuid
  action         String
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  organisationId String   @map("organisation_id") @db.Uuid
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  actorFeId      String?  @map("actor_fe_id") @db.Uuid
  actorRole      String?  @map("actor_role")
  requestId      String?  @map("request_id")
  summary        String?

  @@map("audit_logs")
}

model TenantClient {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId    String    @map("organisation_id") @db.Uuid
  name              String
  slug              String
  /// Operator-friendly search alias (not the slug). Nullable for historical rows.
  companyShortName  String?   @map("company_short_name")
  website           String?
  contactName       String?   @map("contact_name")
  contactEmail      String?   @map("contact_email")
  contactPhone      String?   @map("contact_phone")
  status            String    @default("active")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  vehicles          ClientVehicle[]

  @@unique([organisationId, slug], map: "tenant_clients_organisation_slug_unique")
  @@index([companyShortName], map: "tenant_clients_company_short_name_idx")
  @@index([organisationId], map: "tenant_clients_organisation_id_idx")
  @@map("tenant_clients")
}

/// Per-client vehicle master (tenant-scoped). Unique vehicle_number per client.
model ClientVehicle {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId     String    @map("organisation_id") @db.Uuid
  clientId           String    @map("client_id") @db.Uuid
  vehicleNumber      String    @map("vehicle_number")
  vehicleType        String?   @map("vehicle_type")
  vehicleName        String?   @map("vehicle_name")
  registrationNumber String?   @map("registration_number")
  description        String?
  isActive           Boolean   @default(true) @map("is_active")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  createdBy          String?   @map("created_by") @db.Uuid
  updatedBy          String?   @map("updated_by") @db.Uuid
  client             TenantClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tickets            Ticket[]

  @@unique([clientId, vehicleNumber], map: "client_vehicles_client_vehicle_number_unique")
  @@index([organisationId], map: "client_vehicles_organisation_id_idx")
  @@index([clientId], map: "client_vehicles_client_id_idx")
  @@index([vehicleNumber], map: "client_vehicles_vehicle_number_idx")
  @@map("client_vehicles")
}

/// Tenant-scoped master of attended / resolution locations (Verify & Close).
model TenantResolutionLocation {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId String    @map("organisation_id") @db.Uuid
  name           String
  code           String?
  description    String?
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  createdBy      String?   @map("created_by") @db.Uuid
  updatedBy      String?   @map("updated_by") @db.Uuid
  tickets        Ticket[]

  @@unique([organisationId, name], map: "tenant_resolution_locations_org_name_unique")
  @@index([organisationId], map: "tenant_resolution_locations_organisation_id_idx")
  @@index([isActive], map: "tenant_resolution_locations_is_active_idx")
  @@map("tenant_resolution_locations")
}

model FieldExecutive {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String
  email          String?
  phone          String?
  baseLocation   String?            @map("base_location")
  skills         Json?
  active         Boolean?           @default(true)
  createdAt      DateTime?          @default(now()) @map("created_at") @db.Timestamp(6)
  organisationId String?            @map("organisation_id") @db.Uuid
  userId         String?            @map("user_id") @db.Uuid
  assignments    TicketAssignment[]

  @@map("field_executives")
}

model TicketAssignment {
  id                           String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticketId                     String          @map("ticket_id") @db.Uuid
  feId                         String          @map("fe_id") @db.Uuid
  assignedAt                   DateTime?       @default(now()) @map("assigned_at") @db.Timestamp(6)
  organisationId               String?         @map("organisation_id") @db.Uuid
  assignmentDueAt              DateTime?       @map("assignment_due_at") @db.Timestamptz(6)
  // assignment_notification_* not present on live TEST PG; gated via hasPublicColumn in services.
  proofStoragePath             String?         @map("proof_storage_path")
  createdAt                    DateTime?       @default(now()) @map("created_at") @db.Timestamp(6)
  outcome                      String?
  endedAt                      DateTime?       @map("ended_at") @db.Timestamp(6)
  failureReason                String?         @map("failure_reason")
  fe                           FieldExecutive  @relation(fields: [feId], references: [id])
  ticket                       Ticket          @relation(fields: [ticketId], references: [id])

  @@map("ticket_assignments")
}

model SlaTracking {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticketId            String    @map("ticket_id") @db.Uuid
  assignmentDeadline  DateTime? @map("assignment_deadline") @db.Timestamp(6)
  onsiteDeadline      DateTime? @map("onsite_deadline") @db.Timestamp(6)
  resolutionDeadline  DateTime? @map("resolution_deadline") @db.Timestamp(6)
  assignmentBreached  Boolean?  @default(false) @map("assignment_breached")
  onsiteBreached      Boolean?  @default(false) @map("onsite_breached")
  resolutionBreached  Boolean?  @default(false) @map("resolution_breached")
  createdAt           DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt           DateTime? @default(now()) @map("updated_at") @db.Timestamp(6)
  organisationId      String?   @map("organisation_id") @db.Uuid

  @@map("sla_tracking")
}

model FeActionToken {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticketId         String    @map("ticket_id") @db.Uuid
  feId             String    @map("fe_id") @db.Uuid
  actionType       String    @map("action_type")
  expiresAt        DateTime  @map("expires_at") @db.Timestamp(6)
  used             Boolean   @default(false)
  usedAt           DateTime? @map("used_at") @db.Timestamp(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  tokenState       String    @map("token_state")
  activatedAt      DateTime? @map("activated_at") @db.Timestamp(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamp(6)
  // idempotency_key not on live TEST PG; tokenService uses hasPublicColumn gate.
  organisationId   String?   @map("organisation_id") @db.Uuid

  @@map("fe_action_tokens")
}

model Configuration {
  key       String    @id
  value     Json?
  updatedAt DateTime? @default(now()) @map("updated_at") @db.Timestamp(6)

  @@map("configurations")
}

model AccessToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  feId      String    @map("fe_id") @db.Uuid
  ticketId  String    @map("ticket_id") @db.Uuid
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamp(6)
  revoked   Boolean?  @default(false)
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamp(6)

  @@map("access_tokens")
}

model TenantComplaintPoint {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId    String    @map("organisation_id") @db.Uuid
  name              String
  description       String?
  building          String?
  floor             String?
  siteName          String?   @map("site_name")
  assetReference    String?   @map("asset_reference")
  defaultClientSlug String?   @map("default_client_slug")
  defaultCategory   String?   @map("default_category")
  defaultIssueType  String?   @map("default_issue_type")
  publicToken       String    @unique @map("public_token")
  status            String    @default("active")
  tokenVersion      Int       @default(1) @map("token_version")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  disabledAt        DateTime? @map("disabled_at") @db.Timestamptz(6)
  createdByUserId   String?   @map("created_by_user_id") @db.Uuid

  @@unique([organisationId, name], map: "tenant_complaint_points_org_name_unique")
  @@map("tenant_complaint_points")
}

model PublicOtpSession {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  complaintPointId String    @map("complaint_point_id") @db.Uuid
  organisationId   String    @map("organisation_id") @db.Uuid
  reporterName     String    @map("reporter_name")
  reporterMobile   String    @map("reporter_mobile")
  otpHash          String    @map("otp_hash")
  status           String    @default("pending")
  attemptCount     Int       @default(0) @map("attempt_count")
  resendCount      Int       @default(0) @map("resend_count")
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  verifiedAt       DateTime? @map("verified_at") @db.Timestamptz(6)
  consumedAt       DateTime? @map("consumed_at") @db.Timestamptz(6)
  ticketId         String?   @map("ticket_id") @db.Uuid
  ipHash           String?   @map("ip_hash")
  userAgentHash    String?   @map("user_agent_hash")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("public_otp_sessions")
}

model PublicComplaintSubmission {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticketId         String   @unique @map("ticket_id") @db.Uuid
  complaintPointId String   @map("complaint_point_id") @db.Uuid
  organisationId   String   @map("organisation_id") @db.Uuid
  otpSessionId     String   @map("otp_session_id") @db.Uuid
  reporterName     String   @map("reporter_name")
  reporterMobile   String   @map("reporter_mobile")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("public_complaint_submissions")
}

model TicketNumberSequence {
  sequenceDate DateTime @map("sequence_date") @db.Date
  sourceCode   String   @map("source_code") @db.Char(1)
  lastNumber   Int      @default(0) @map("last_number")
  updatedAt    DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@id([sequenceDate, sourceCode])
  @@map("ticket_number_sequences")
}

model DailyTenantReportRun {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId String    @map("organisation_id") @db.Uuid
  reportDate     DateTime  @map("report_date") @db.Date
  status         String
  recipientCount Int?      @map("recipient_count")
  ticketCount    Int?      @map("ticket_count")
  error          String?
  sentAt         DateTime? @map("sent_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([organisationId, reportDate], map: "daily_tenant_report_runs_org_date_unique")
  @@map("daily_tenant_report_runs")
}

model FeProofBackupQueue {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticketCommentId String   @map("ticket_comment_id") @db.Uuid
  ticketId        String   @map("ticket_id") @db.Uuid
  actionType      String   @map("action_type")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  organisationId  String?  @map("organisation_id") @db.Uuid

  @@map("fe_proof_backup_queue")
}

model TicketResolutionNotification {
  ticketId String @id @map("ticket_id") @db.Uuid

  @@map("ticket_resolution_notifications")
}
