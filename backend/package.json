{
  "name": "pariskq-crm-backend",
  "version": "1.0.0",
  "type": "module",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "node src/app.js",
    "prisma:generate": "prisma generate",
    "prisma:pull": "prisma db pull",
    "seed:test": "node prisma/seed-test.js",
    "test": "vitest run",
    "test:repo": "vitest run --config vitest.repo.config.js",
    "test:integration": "vitest run --config vitest.integration.config.js",
    "test:coverage": "vitest run --coverage",
    "test:coverage:repo": "vitest run --config vitest.repo.config.js --coverage",
    "test:coverage:integration": "vitest run --config vitest.integration.config.js --coverage"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "PariskQ CRM backend – email to ticket automation",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1050.0",
    "@aws-sdk/s3-request-presigner": "^3.1101.0",
    "@prisma/client": "^6.19.0",
    "@supabase/supabase-js": "^2.89.0",
    "axios": "^1.13.5",
    "body-parser": "^2.2.2",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.0.9",
