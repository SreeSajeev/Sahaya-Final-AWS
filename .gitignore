# Root ignore for Sahaya-Final-AWS monorepo

# Dependencies
node_modules/
**/node_modules/

# Env / secrets
.env
.env.*
!**/.env.example

# OS / editor
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# Build outputs
dist/
dist-ssr/
**/dist/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Playwright / E2E generated artifacts
e2e/node_modules/
e2e/test-results/
e2e/playwright-report/
e2e/blob-report/
e2e/playwright/.cache/
**/test-results/
**/playwright-report/
