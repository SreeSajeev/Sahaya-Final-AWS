# E2E credentials — copy to e2e/.env (never commit secrets)
# Defaults target TEST. For local, set E2E_SKIP_WEB_SERVER=0 and localhost URLs.

E2E_BASE_URL=https://test-sahaya.pariskq.in
E2E_API_URL=https://api.test-sahaya.pariskq.in
E2E_SKIP_WEB_SERVER=1

E2E_SUPER_ADMIN_EMAIL=
E2E_SUPER_ADMIN_PASSWORD=

E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=

E2E_STAFF_EMAIL=
E2E_STAFF_PASSWORD=

E2E_FE_EMAIL=
E2E_FE_PASSWORD=

# Optional: existing FE action token UUID for proof upload browser path
E2E_FE_ACTION_TOKEN_ID=
